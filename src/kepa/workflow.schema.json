{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kepa.local/schemas/workflow-v1.json",
  "title": "KEPA Evidence Workflow v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "inputs",
    "query",
    "steps",
    "outputs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exam",
        "query"
      ],
      "properties": {
        "exam": {
          "const": "MRIExam"
        },
        "query": {
          "const": "DiagnosticQuery"
        }
      }
    },
    "requested_regions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[CTLS][0-9]+(/[CTLS][0-9]+)?$"
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "required_views"
      ],
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1
        },
        "required_views": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "sagittal_t2",
              "axial_t2"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tool",
          "operation",
          "inputs",
          "options"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "tool": {
            "enum": [
              "segmentation",
              "3d_matching",
              "slice_selection",
              "roi_extraction"
            ]
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "options": {
            "type": "object"
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "evidence"
          ]
        },
        {
          "required": [
            "results"
          ]
        }
      ]
    },
    "save_qc": {
      "type": "boolean",
      "default": false
    }
  }
}
