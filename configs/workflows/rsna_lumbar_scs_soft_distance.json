{
  "schema_version": "1.0",
  "id": "rsna_lumbar_scs_soft_distance_requested_5",
  "inputs": {
    "sag": "sagittal_t2",
    "axl": "axial_t2"
  },
  "query": {
    "task": "spinal_canal_stenosis",
    "required_views": [
      "sagittal_t2",
      "axial_t2"
    ]
  },
  "requested_regions": {
    "sagittal_t2": [
      "L1/L2",
      "L2/L3",
      "L3/L4",
      "L4/L5",
      "L5/S1"
    ],
    "axial_t2": [
      "L1/L2",
      "L2/L3",
      "L3/L4",
      "L4/L5",
      "L5/S1"
    ]
  },
  "steps": [
    {
      "id": "segment_sagittal",
      "tool": "TotalSpineSeg",
      "input": "sagittal_t2",
      "output": "sagittal_labels",
      "labels": {
        "spinal_canal": [
          1,
          2
        ],
        "L1/L2": 92,
        "L2/L3": 93,
        "L3/L4": 94,
        "L4/L5": 95,
        "L5/S1": 100,
        "T11": 31,
        "T12": 32,
        "L1": 41,
        "L2": 42,
        "L3": 43,
        "L4": 44,
        "L5": 45,
        "S1": 50
      }
    },
    {
      "id": "segment_axial_canal",
      "tool": "AxialCanalSeg",
      "input": "axial_t2",
      "output": "axial_labels",
      "labels": {
        "spinal_canal": [
          1
        ]
      }
    },
    {
      "id": "clean_axial_canal",
      "tool": "segmentation",
      "operation": "postprocess",
      "input": "axial_labels",
      "output": "clean_axial_labels",
      "options": {
        "method": "center_nearest_largest_component",
        "target_labels": "spinal_canal",
        "minimum_area_fraction": 0.5
      }
    },
    {
      "id": "select_sagittal_canal_reference",
      "tool": "slice_selection",
      "operation": "select_sagittal_reference",
      "output": "sagittal_canal_reference_slice",
      "inputs": {
        "series": "sagittal_t2",
        "mask": "sagittal_labels"
      },
      "options": {
        "selector": "max_label_union_area",
        "labels": "spinal_canal"
      }
    },
    {
      "id": "match_disc_levels_to_axial",
      "tool": "3d_matching",
      "operation": "match_anatomical_levels",
      "inputs": {
        "source_series": "sagittal_t2",
        "target_series": "axial_t2",
        "source_mask": "sagittal_labels",
        "reference_slice": "sagittal_canal_reference_slice"
      },
      "options": {
        "direction": "sagittal_to_axial",
        "method": "soft_distance",
        "sigma_mm": 3,
        "requested_regions": [
          "L1/L2",
          "L2/L3",
          "L3/L4",
          "L4/L5",
          "L5/S1"
        ],
        "region_label_ids": {
          "L1/L2": [
            92
          ],
          "L2/L3": [
            93
          ],
          "L3/L4": [
            94
          ],
          "L4/L5": [
            95
          ],
          "L5/S1": [
            100
          ]
        }
      },
      "output": "axial_disc_slices"
    },
    {
      "id": "build_sagittal_disc_rois",
      "tool": "roi_extraction",
      "operation": "composite_bbox",
      "inputs": {
        "series": "sagittal_t2",
        "mask": "sagittal_labels",
        "slice_selection": "sagittal_canal_reference_slice"
      },
      "options": {
        "preset_file": "rsna_scs_sagittal_disc_canal_10pct.json"
      },
      "output": "sagittal_scs_rois"
    },
    {
      "id": "build_axial_canal_rois",
      "tool": "roi_extraction",
      "operation": "composite_bbox",
      "inputs": {
        "series": "axial_t2",
        "mask": "clean_axial_labels",
        "slice_selection": "axial_disc_slices"
      },
      "options": {
        "preset_file": "rsna_scs_axial_canal_center48.json",
        "reference_size": [
          512,
          512
        ]
      },
      "output": "axial_scs_rois"
    }
  ],
  "outputs": {
    "results": [
      "sagittal_scs_rois",
      "axial_scs_rois"
    ]
  },
  "save_qc": true
}
