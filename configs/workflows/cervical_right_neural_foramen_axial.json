{
  "schema_version": "1.0",
  "id": "cervical_right_neural_foramen_axial_v1",
  "inputs": {
    "sag": "sagittal_t2",
    "axl": "axial_t2"
  },
  "query": {
    "task": "right_neural_foraminal_stenosis",
    "required_views": [
      "axial_t2"
    ]
  },
  "requested_regions": {
    "axial_t2": [
      "C3/C4",
      "C4/C5",
      "C5/C6",
      "C6/C7"
    ]
  },
  "steps": [
    {
      "id": "segment_sagittal",
      "tool": "TotalSpineSeg",
      "input": "sagittal_t2",
      "output": "sagittal_labels",
      "labels": {
        "spinal_canal": [
          1,
          2
        ],
        "C3": 13,
        "C4": 14,
        "C5": 15,
        "C6": 16,
        "C7": 17,
        "C3/C4": 64,
        "C4/C5": 65,
        "C5/C6": 66,
        "C6/C7": 67
      }
    },
    {
      "id": "segment_axial_canal",
      "tool": "AxialCanalSeg",
      "input": "axial_t2",
      "output": "axial_labels",
      "labels": {
        "spinal_canal": [
          1
        ]
      }
    },
    {
      "id": "postprocess_sagittal",
      "tool": "segmentation",
      "operation": "postprocess",
      "input": "sagittal_labels",
      "output": "clean_sagittal_labels",
      "options": {
        "method": "anterior_largest_component",
        "target_labels": [
          "vertebral_bodies",
          "intervertebral_discs"
        ],
        "reference_labels": "spinal_canal"
      }
    },
    {
      "id": "postprocess_axial_canal",
      "tool": "segmentation",
      "operation": "postprocess",
      "input": "axial_labels",
      "output": "clean_axial_labels",
      "options": {
        "method": "center_nearest_largest_component",
        "target_labels": "spinal_canal",
        "minimum_area_fraction": 0.5
      }
    },
    {
      "id": "select_sagittal_reference",
      "tool": "slice_selection",
      "operation": "select_sagittal_reference",
      "output": "sagittal_reference_slice",
      "inputs": {
        "series": "sagittal_t2",
        "mask": "clean_sagittal_labels"
      },
      "options": {
        "selector": "max_label_union_area",
        "labels": "spinal_canal"
      }
    },
    {
      "id": "match_sagittal_to_axial_disc_levels",
      "tool": "3d_matching",
      "operation": "match_anatomical_levels",
      "inputs": {
        "source_series": "sagittal_t2",
        "target_series": "axial_t2",
        "source_mask": "clean_sagittal_labels",
        "reference_slice": "sagittal_reference_slice"
      },
      "options": {
        "direction": "sagittal_to_axial",
        "method": "ratio",
        "neighborhood_radius": 1,
        "min_voxels_per_sagittal_slice": 41
      },
      "output": "axial_disc_slices"
    },
    {
      "id": "build_right_foramen_rois",
      "tool": "roi_extraction",
      "operation": "composite_bbox",
      "inputs": {
        "series": "axial_t2",
        "mask": "clean_axial_labels",
        "slice_selection": "axial_disc_slices"
      },
      "options": {
        "preset_file": "axial_right_foramen_shift_half_v1.json"
      },
      "output": "right_foramen_rois"
    }
  ],
  "outputs": {
    "results": [
      "right_foramen_rois"
    ]
  },
  "save_qc": true
}
